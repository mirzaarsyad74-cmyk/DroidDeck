#!/bin/bash
# ==============================================================================
# DroidDeck Built-in CloudRedirect Integration Manager
# Enables cross-platform cloud save sync (Google Drive, OneDrive, S3/R2, WebDAV)
# ==============================================================================
set -euo pipefail

CR_VERSION="linux-v2.9.117"
CR_BASE_URL="https://github.com/mirzaarsyad74-cmyk/Cloudredirect/releases/download/${CR_VERSION}"

LIB_DEST="/usr/local/lib/libcloud_redirect.so"
BIN_DEST="/usr/local/bin/cloud_redirect_cli"
USER_LIB_DEST="${HOME}/.local/lib/libcloud_redirect.so"
USER_BIN_DEST="${HOME}/.local/bin/cloud_redirect_cli"
FEX_LIB_DEST="/usr/local/lib/droiddeck-fex/x86_64/libcloud_redirect.so"
USER_FEX_LIB_DEST="${HOME}/.local/lib/droiddeck-fex/x86_64/libcloud_redirect.so"

usage() {
    echo "Usage: droiddeck-cloudredirect <command> [args]"
    echo ""
    echo "Commands:"
    echo "  install [--quiet]    Download and install CloudRedirect binaries"
    echo "  status               Show CloudRedirect installation & sync status"
    echo "  auth <provider>      Authenticate cloud provider (e.g. gdrive, onedrive)"
    echo "  sync [appid]         Manually trigger cloud save sync"
    echo "  log                  Display CloudRedirect log output"
    echo ""
}

get_cli() {
    if command -v cloud_redirect_cli >/dev/null 2>&1; then
        echo "cloud_redirect_cli"
    elif [ -x "$BIN_DEST" ]; then
        echo "$BIN_DEST"
    elif [ -x "$USER_BIN_DEST" ]; then
        echo "$USER_BIN_DEST"
    else
        echo ""
    fi
}

run_cli() {
    local cli
    cli=$(get_cli)
    if [ -z "$cli" ]; then
        echo "[-] CloudRedirect CLI not found. Run 'droiddeck-cloudredirect install' first." >&2
        return 1
    fi

    local fex=()
    if [ -x /usr/local/bin/droiddeck-fex ]; then
        case $(od -An -tu2 -j18 -N2 "$cli" 2>/dev/null | tr -d ' ') in
            3|62) fex=(/usr/local/bin/droiddeck-fex run --mode on --) ;;
        esac
    fi

    "${fex[@]}" "$cli" "$@"
}

cmd_install() {
    local quiet=0
    [ "${1:-}" = "--quiet" ] && quiet=1

    [ $quiet -eq 0 ] && echo "[+] Installing / Updating CloudRedirect for DroidDeck..."

    local target_lib="$USER_LIB_DEST"
    local target_bin="$USER_BIN_DEST"
    local target_fex_lib="$USER_FEX_LIB_DEST"
    if [ -w "/usr/local/lib" ] 2>/dev/null && [ -w "/usr/local/bin" ] 2>/dev/null; then
        target_lib="$LIB_DEST"
        target_bin="$BIN_DEST"
        target_fex_lib="$FEX_LIB_DEST"
    fi

    mkdir -p "$(dirname "$target_lib")" "$(dirname "$target_bin")" "$(dirname "$target_fex_lib")" \
             "${HOME}/.config/CloudRedirect" "${HOME}/.local/share/cloudredirect"

    local machine
    machine=$(uname -m)
    local asset_arch="arm64"
    case "$machine" in
        x86_64|amd64) asset_arch="x64" ;;
        aarch64|arm64) asset_arch="arm64" ;;
        *) asset_arch="arm64" ;;
    esac

    local work
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT

    local primary_url="${CR_BASE_URL}/cloudredirect-linux-${asset_arch}.tar.gz"
    [ $quiet -eq 0 ] && echo "[+] Downloading CloudRedirect ${CR_VERSION} (${asset_arch})..."
    if curl -fsSL --retry 3 "${primary_url}" -o "${work}/cr.tar.gz"; then
        tar -xzf "${work}/cr.tar.gz" -C "${work}"
        local extracted_dir="${work}/cloudredirect-linux-${asset_arch}"
        if [ -d "$extracted_dir" ]; then
            cp -f "${extracted_dir}/bin/libcloud_redirect.so" "${target_lib}"
            cp -f "${extracted_dir}/bin/cloud_redirect_cli" "${target_bin}"
            chmod 755 "${target_lib}" "${target_bin}"

            # Create default config if not present
            local cfg="${HOME}/.config/CloudRedirect/config.json"
            if [ ! -f "$cfg" ]; then
                cat <<'EOF' > "$cfg"
{
  "provider": "gdrive",
  "all_apps": true,
  "sync_achievements": true,
  "sync_playtime": true,
  "apps": []
}
EOF
                chmod 600 "$cfg"
            fi

            # Add desktop shortcut
            mkdir -p "${HOME}/Desktop" "${HOME}/.local/share/applications"
            cat <<'EOF' > "${HOME}/.local/share/applications/cloudredirect.desktop"
[Desktop Entry]
Name=CloudRedirect
Comment=Cross-platform Cloud Save Sync for Steam
Exec=droiddeck-cloudredirect status
Icon=network-transmit-receive
Terminal=true
Type=Application
Categories=Game;Utility;
EOF
            cp -f "${HOME}/.local/share/applications/cloudredirect.desktop" "${HOME}/Desktop/" 2>/dev/null || true
            chmod +x "${HOME}/Desktop/cloudredirect.desktop" 2>/dev/null || true

            [ $quiet -eq 0 ] && echo "[+] CloudRedirect successfully installed to ${target_lib}!"
        fi
    else
        [ $quiet -eq 0 ] && echo "[-] Failed to download CloudRedirect ${asset_arch} bundle."
        return 1
    fi

    # If host is ARM64, fetch x86_64 libcloud_redirect.so for Proton/FEX games
    if [ "$asset_arch" = "arm64" ]; then
        local x64_url="${CR_BASE_URL}/cloudredirect-linux-x64.tar.gz"
        if curl -fsSL --retry 2 "${x64_url}" -o "${work}/cr-x64.tar.gz" 2>/dev/null; then
            tar -xzf "${work}/cr-x64.tar.gz" -C "${work}" 2>/dev/null || true
            if [ -f "${work}/cloudredirect-linux-x64/bin/libcloud_redirect.so" ]; then
                mkdir -p "$(dirname "$target_fex_lib")"
                cp -f "${work}/cloudredirect-linux-x64/bin/libcloud_redirect.so" "${target_fex_lib}"
                chmod 755 "${target_fex_lib}"
                [ $quiet -eq 0 ] && echo "[+] FEX x86_64 preload library staged to ${target_fex_lib}."
            fi
        fi
    fi
}

cmd_status() {
    echo "=== DroidDeck CloudRedirect Status ==="
    local cli
    cli=$(get_cli)
    if [ -n "$cli" ]; then
        echo "CLI Binary:    $(command -v "$cli" || echo "$cli")"
    else
        echo "CLI Binary:    Not found (run 'droiddeck-cloudredirect install')"
    fi

    for lib in "$LIB_DEST" "$USER_LIB_DEST" "${HOME}/.local/share/Steam/libcloud_redirect.so"; do
        if [ -f "$lib" ]; then
            echo "Preload Lib:   $lib (Ready)"
            break
        fi
    done

    for fex_lib in "$FEX_LIB_DEST" "$USER_FEX_LIB_DEST"; do
        if [ -f "$fex_lib" ]; then
            echo "FEX x86 Lib:   $fex_lib (Ready)"
            break
        fi
    done

    echo "Config:        ${HOME}/.config/CloudRedirect/config.json"
    if [ -f "${HOME}/.config/CloudRedirect/config.json" ]; then
        grep -E '"provider"|"all_apps"' "${HOME}/.config/CloudRedirect/config.json" || true
    fi

    if [ -n "$cli" ]; then
        echo ""
        echo "--- Cloud Provider Auth Status ---"
        run_cli auth-status gdrive || true
        run_cli auth-status onedrive || true
    fi
}

cmd_auth() {
    local provider="${1:-}"
    if [ -z "$provider" ]; then
        echo "Please specify provider: gdrive, onedrive, s3, r2, webdav" >&2
        exit 1
    fi
    local cli
    cli=$(get_cli)
    if [ -z "$cli" ]; then
        echo "CloudRedirect CLI not installed yet. Running install..."
        cmd_install
        cli=$(get_cli)
    fi
    run_cli authenticate "$provider"
}

cmd_sync() {
    local cli
    cli=$(get_cli)
    if [ -z "$cli" ]; then
        echo "CloudRedirect CLI not installed yet. Running install..."
        cmd_install
        cli=$(get_cli)
    fi
    run_cli sync "$@"
}

cmd_log() {
    local log="${HOME}/.local/share/cloudredirect/cloud_redirect.log"
    if [ -f "$log" ]; then
        tail -n 100 "$log"
    else
        echo "No log found at $log"
    fi
}

action="${1:-status}"
shift || true

case "$action" in
    install) cmd_install "$@" ;;
    status) cmd_status ;;
    auth|authenticate) cmd_auth "$@" ;;
    sync) cmd_sync "$@" ;;
    log|logs) cmd_log ;;
    help|--help|-h) usage ;;
    *) echo "Unknown command: $action"; usage; exit 1 ;;
esac
